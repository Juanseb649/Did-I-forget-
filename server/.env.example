# Copia este archivo a .env (para "vercel dev") y nunca lo subas a git.
# En producción estos valores se configuran como variables de entorno en Vercel
# (ver server/README.md), no en un archivo .env.

# Tu API key de OpenAI (platform.openai.com/api-keys). Solo vive aquí, nunca en la app.
OPENAI_API_KEY=sk-proj-reemplaza-con-tu-key-de-openai


# Un string largo y aleatorio inventado por ti (ej. generado con `openssl rand -hex 32`).
# Debe coincidir con el mismo valor que pongas en local.properties del proyecto Android.
APP_SHARED_SECRET=reemplaza-con-el-resultado-de-openssl-rand-hex-32
